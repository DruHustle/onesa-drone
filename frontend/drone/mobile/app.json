{
  "expo": {
    "name": "Onesa Drone",
    "slug": "onesa-drone-mobile",
    "scheme": "onesadrone",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eu.onesa.drone",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "eu.onesa.drone",
      "permissions": [],
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "hardwareFlightEnabled": false,
      "simulationOnly": true
    },
    "icon": "./assets/app-icon.png"
  }
}
