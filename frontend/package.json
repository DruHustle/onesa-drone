{
  "name": "@onesa/ai-drone-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3400",
