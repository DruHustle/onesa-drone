{
  "components": {
    "schemas": {
      "AircraftCommand": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "inspect",
              "decommission",
              "restore",
              "charge",
              "maintenance"
            ],
            "title": "Action",
            "type": "string"
          },
          "note": {
            "default": "",
            "maxLength": 500,
            "title": "Note",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "action",
          "revision"
        ],
        "title": "AircraftCommand",
        "type": "object"
      },
      "AircraftIn": {
        "additionalProperties": false,
        "properties": {
          "capacity": {
            "exclusiveMinimum": 0.0,
            "maximum": 100.0,
            "title": "Capacity",
            "type": "number"
          },
          "category": {
            "enum": [
              "multirotor",
              "fixed-wing",
              "vtol"
            ],
            "title": "Category",
            "type": "string"
          },
          "endurance": {
            "maximum": 240.0,
            "minimum": 5.0,
            "title": "Endurance",
            "type": "number"
          },
          "manufacturer": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Manufacturer",
            "type": "string"
          },
          "model": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "name": {
            "maxLength": 40,
            "minLength": 2,
            "pattern": "^[\\w .-]+$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "model",
          "manufacturer",
          "category",
          "capacity",
          "endurance"
        ],
        "title": "AircraftIn",
        "type": "object"
      },
      "AssistantIn": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 2,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AssistantIn",
        "type": "object"
      },
      "Command": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "plan",
              "validate",
              "authorize",
              "launch",
              "cancel",
              "recover",
              "reschedule",
              "replan"
            ],
            "title": "Action",
            "type": "string"
          },
          "aircraft_id": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aircraft Id"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "scheduled_at": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled At"
          }
        },
        "required": [
          "action",
          "revision"
        ],
        "title": "Command",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IncidentIn": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 1000,
            "minLength": 3,
            "title": "Detail",
            "type": "string"
          },
          "title": {
            "maxLength": 100,
            "minLength": 3,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "title": "IncidentIn",
        "type": "object"
      },
      "IncidentUpdate": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "open",
              "investigating",
              "resolved"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "IncidentUpdate",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 160,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "MissionIn": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "label": {
            "maxLength": 100,
            "minLength": 2,
            "title": "Label",
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "package_kind": {
            "default": "standard",
            "enum": [
              "standard",
              "medical",
              "fragile"
            ],
            "title": "Package Kind",
            "type": "string"
          },
          "package_weight": {
            "exclusiveMinimum": 0.0,
            "maximum": 100.0,
            "title": "Package Weight",
            "type": "number"
          },
          "scenario": {
            "default": "nominal",
            "enum": [
              "nominal",
              "low_battery",
              "communication_loss",
              "gps_degradation",
              "weather",
              "obstruction",
              "aircraft_fault"
            ],
            "title": "Scenario",
            "type": "string"
          },
          "scheduled_at": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled At"
          }
        },
        "required": [
          "label",
          "package_weight",
          "origin",
          "destination"
        ],
        "title": "MissionIn",
        "type": "object"
      },
      "Point": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 85.0,
            "minimum": -85.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "Point",
        "type": "object"
      },
      "SettingsIn": {
        "additionalProperties": false,
        "properties": {
          "altitude_m": {
            "default": 60,
            "maximum": 100.0,
            "minimum": 10.0,
            "title": "Altitude M",
            "type": "number"
          },
          "currency": {
            "enum": [
              "EUR",
              "USD",
              "ZAR",
              "NAD",
              "BWP",
              "ZMW",
              "GBP"
            ],
            "title": "Currency",
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "de"
            ],
            "title": "Language",
            "type": "string"
          },
          "region": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Region",
            "type": "string"
          },
          "reserve_percent": {
            "default": 25,
            "maximum": 80.0,
            "minimum": 25.0,
            "title": "Reserve Percent",
            "type": "number"
          },
          "units": {
            "enum": [
              "metric",
              "imperial"
            ],
            "title": "Units",
            "type": "string"
          },
          "virtual_radius_m": {
            "default": 3000,
            "maximum": 3000.0,
            "minimum": 100.0,
            "title": "Virtual Radius M",
            "type": "number"
          },
          "wind_mps": {
            "default": 5,
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Wind Mps",
            "type": "number"
          }
        },
        "required": [
          "currency",
          "units",
          "language",
          "region"
        ],
        "title": "SettingsIn",
        "type": "object"
      },
      "UserIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 160,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 14,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "viewer",
              "operator",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "UserIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
