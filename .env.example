DATABASE_URL=sqlite:///./drone.db
APP_ORIGIN=http://127.0.0.1:3400
COOKIE_SECURE=false
SIMULATION_WORKER=true
# Server-only dedicated AI identity settings; leave unset until approved.
ONESA_AI_URL=
ONESA_AI_ORIGIN=
ONESA_AI_TENANT_ID=
ONESA_AI_DELEGATED_SESSION=
ONESA_AI_DELEGATED_CSRF=
# Shared Onesa identity is enabled only after issuer/client registration and migration.
ONESA_IDENTITY_ENABLED=false
ONESA_IDENTITY_ISSUER=
ONESA_IDENTITY_CLIENT_ID=
ONESA_IDENTITY_CLIENT_SECRET=
# Exact frontend callback; never a caller-provided return URL.
ONESA_IDENTITY_CALLBACK=
ONESA_IDENTITY_ENCRYPTION_KEY=
